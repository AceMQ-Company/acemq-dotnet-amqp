<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AceMq.Amqp\AceMq.Amqp.csproj" />
    <ProjectReference Include="..\..\src\AceMq.Amqp.Avro\AceMq.Amqp.Avro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared fixtures live in one place, AceMq.Amqp.Tests/fixtures, because
         ../scripts/check-fixtures.sh compares that path against the other four
         libraries byte for byte. Linked into this project's output rather than
         copied, so there is one file on disk and not two that can disagree. -->
    <None Include="..\AceMq.Amqp.Tests\fixtures\avro-resolution-fixtures.json"
          Link="fixtures\avro-resolution-fixtures.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
