<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\AceMq.Amqp\AceMq.Amqp.csproj" />
    <!-- Not because the sample needs Avro, but because the Avro package grew a
         public surface today and this project is what proves a VB consumer can
         reach it. The reflection audit checks the shape; only a compiler proves
         the shape is callable. -->
    <ProjectReference Include="..\..\src\AceMq.Amqp.Avro\AceMq.Amqp.Avro.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>vb</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
      <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
